# Copy this file to keystore.properties (which git ignores) and fill it in.
# The release build is signed only when keystore.properties exists.
#
# Write the path with forward slashes, even on Windows:
#   storeFile=C:/keys/upload-keystore.jks
# A backslash is an escape character in this file format and would be dropped.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
